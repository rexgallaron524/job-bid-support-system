{
  "name": "all-in-one-place-job-support",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "node --env-file-if-exists=.env scripts/check-environment.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "test": "node --experimental-strip-types --test tests/domain.test.mjs tests/security.test.mjs tests/export.test.mjs tests/profile.test.mjs",
    "test:api": "node --experimental-strip-types --env-file-if-exists=.env tests/api.test.mjs",
    "test:integration": "node --env-file-if-exists=.env tests/run-integration.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "manager:create": "node --env-file-if-exists=.env scripts/account.mjs create-manager",
    "account:reset-password": "node --env-file-if-exists=.env scripts/account.mjs reset-password",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "playwright-core": "^1.64.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {}
}
