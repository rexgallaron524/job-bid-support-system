# Use a dedicated PostgreSQL database. Percent-encode special characters in the URL password.
DATABASE_URL=postgresql://job_support:REPLACE_ME@127.0.0.1:5432/job_support
# Must exactly match the address in your browser, with no trailing slash.
APP_ORIGIN=http://localhost:3000
# This path adds obscurity; authentication and manager role checks provide access control.
MANAGER_PATH=manager
# Enable ONLY when a trusted reverse proxy overwrites forwarding headers and the app port is private.
TRUST_PROXY=false
# For Docker Compose only (set to your chosen DuckDNS/custom domain):
SITE_DOMAIN=your-name.duckdns.org
POSTGRES_USER=job_support
POSTGRES_DB=job_support
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

